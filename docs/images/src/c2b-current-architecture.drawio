  <diagram name="C2B 当前实现架构" id="c2b-current-architecture">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="spacer" value="" style="fillColor=none;strokeColor=none;opacity=0;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1160" height="750" as="geometry"/></mxCell>
        <mxCell id="title" value="Code2Business 当前实现架构：三种产品共用一个可追溯业务知识内核" style="text;html=1;align=center;fontSize=17;fontStyle=1;fontColor=#1a4f7a;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1080" height="30" as="geometry"/></mxCell>

        <mxCell id="products" value="三个独立产品入口" style="swimlane;startSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;html=1;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="190" height="490" as="geometry"/></mxCell>
        <mxCell id="web" value="Web 工作台&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Vue 前端 + FastAPI&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="products"><mxGeometry x="25" y="55" width="140" height="62" as="geometry"/></mxCell>
        <mxCell id="cli" value="CLI&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Python wheel / CI / 脚本&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="products"><mxGeometry x="25" y="175" width="140" height="62" as="geometry"/></mxCell>
        <mxCell id="skills" value="Agent Skills&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;当前 Codex / Claude Code 会话&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="products"><mxGeometry x="25" y="295" width="140" height="62" as="geometry"/></mxCell>
        <mxCell id="independent" value="可分别部署；只有需要协同查看结果时才共用 PostgreSQL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;fontColor=#444444;" vertex="1" parent="products"><mxGeometry x="25" y="405" width="140" height="55" as="geometry"/></mxCell>

        <mxCell id="core" value="共享 Core：确定性代码图谱与业务知识引擎" style="swimlane;startSize=30;fillColor=#e1d5e7;strokeColor=#9673a6;html=1;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="300" y="80" width="500" height="490" as="geometry"/></mxCell>
        <mxCell id="import" value="代码导入&lt;br&gt;ZIP / Git / 本地目录" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="core"><mxGeometry x="25" y="55" width="125" height="55" as="geometry"/></mxCell>
        <mxCell id="scan" value="确定性扫描&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;probe → 分片 → tree-sitter / SQL 提取&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="core"><mxGeometry x="185" y="55" width="270" height="55" as="geometry"/></mxCell>
        <mxCell id="graph" value="代码事实图谱&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;模块、方法、入口、调用边、接口、表、SQL、行号&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="core"><mxGeometry x="25" y="150" width="430" height="58" as="geometry"/></mxCell>
        <mxCell id="semantic" value="语义与可信度层&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;业务域、对象、规则、流程、主线、待确认项&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="core"><mxGeometry x="25" y="255" width="205" height="60" as="geometry"/></mxCell>
        <mxCell id="confirm" value="人工确认与审计&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;confirm / modify / discard&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="core"><mxGeometry x="250" y="255" width="205" height="60" as="geometry"/></mxCell>
