# Code2Business LLM 配置示例
# 用法：复制为 .env 并填写，或直接 export 同名环境变量
# 配置优先级：环境变量 > .env > ~/.c2b/config.json > 默认

# LLM 模式: api（默认）/ mock（内置模拟，无需 Key，用于验证管线）
# C2B_LLM_MODE=api

# Provider: openai_compatible（默认）或 anthropic
C2B_LLM_PROVIDER=openai_compatible

# OpenAI Compatible 地址（DeepSeek 默认；也支持 OpenAI/Kimi/Ollama/自建网关）
# Anthropic Native 通常使用 https://api.anthropic.com
C2B_LLM_BASE_URL=https://api.deepseek.com/v1

# API Key（必填，api 模式下）
C2B_LLM_API_KEY=

# 模型名
C2B_LLM_MODEL=deepseek-chat

# 数据库（默认 SQLite: ./c2b.db；生产可切 PostgreSQL）
# C2B_DB_URL=postgresql+psycopg://user:pass@localhost:5432/c2b

# 安全默认只允许公网 HTTPS。仅在可信本机/内网连接 Ollama 等服务时开启。
C2B_ALLOW_PRIVATE_LLM=0
C2B_ALLOW_PRIVATE_GIT=0

# Web 进程内任务租约秒数；进程重启后遗留任务会变为可重试失败状态。
C2B_JOB_LEASE_SECONDS=300
