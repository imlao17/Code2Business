# Code2Business Web deployment configuration.
# Copy this file to .env before first start.  Keep .env private: it contains
# database and optional API credentials.  Passwords used in C2B_DB_URL must be
# URL-safe (letters, digits, '-' and '_' are safe choices).

C2B_POSTGRES_DB=c2b
C2B_POSTGRES_USER=c2b
C2B_POSTGRES_PASSWORD=replace-with-a-long-url-safe-secret

# Keep 127.0.0.1 for a local workstation.  For remote use, place an HTTPS
# reverse proxy with authentication in front of C2B before changing this.
C2B_WEB_BIND=127.0.0.1

# Optional API token for a reverse proxy or API client.  Leave blank only for
# a trusted local workstation deployment.
C2B_API_TOKEN=

# Security defaults: only public HTTPS LLM/Git endpoints are permitted.
# Set to 1 only in a trusted internal network for Docker, host, or LAN models.
C2B_ALLOW_PRIVATE_LLM=0
C2B_ALLOW_PRIVATE_GIT=0

# A running job that has not refreshed its lease for this duration is marked
# failed on the next API startup or when a new job is created for its project.
C2B_JOB_LEASE_SECONDS=300
